# =============================================================================
# Text-to-SQL RAG Assistant — Environment Variables Template
#
# 1. Copy this file to .env in the project root:
#      cp .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env to Git — it is in .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Gemini API Key
# Obtain from: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# MySQL — Admin credentials (used ONLY by setup/fake_data.py)
# This user must have CREATE, INSERT, DROP privileges to set up the schema.
# ---------------------------------------------------------------------------
MYSQL_ADMIN_HOST=localhost
MYSQL_ADMIN_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=your_admin_password_here
MYSQL_DATABASE=text_to_sql_db

# ---------------------------------------------------------------------------
# MySQL — Application credentials (used by the Streamlit app at runtime)
# This user has SELECT-only privileges — see README for setup instructions.
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=textsql_reader
MYSQL_PASSWORD=your_readonly_password_here
